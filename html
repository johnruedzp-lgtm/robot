<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<title>Boop Robot</title>
<style>
  * { margin:0; padding:0; box-sizing:border-box; }
  html,body { width:100%; height:100%; overflow:hidden; background:#0a0a12;
    font-family:sans-serif; touch-action:none; }
  #cam { position:fixed; inset:0; width:100%; height:100%; object-fit:cover;
    transform:scaleX(-1); opacity:0.25; filter:saturate(0.6); }
  #face { position:fixed; inset:0; width:100%; height:100%; }
  .eye { transition:all .18s ease; }
  .blink { animation:blink 4.2s infinite; }
  @keyframes blink { 0%,94%,100%{transform:scaleY(1)} 96%{transform:scaleY(.08)} }
  .shake { animation:shake .55s ease; }
  @keyframes shake { 0%,100%{transform:translateX(0)} 20%{transform:translateX(-14px)}
    40%{transform:translateX(11px)} 60%{transform:translateX(-7px)} 80%{transform:translateX(5px)} }
  #label { position:fixed; bottom:22%; left:0; right:0; text-align:center;
    color:#9aa0b4; font-size:15px; pointer-events:none; }
  #btns { position:fixed; bottom:6%; left:0; right:0; display:flex; gap:10px;
    justify-content:center; }
  #btns button { padding:12px 18px; border-radius:12px; border:1px solid #3a3f55;
    background:#16182a; color:#e8eaff; font-size:15px; }
  #btns button:active { background:#e8eaff; color:#0a0a12; }
  #status { position:fixed; top:calc(env(safe-area-inset-top, 0px) + 10px);
    left:0; right:0; display:flex; gap:16px; justify-content:center;
    font-size:12px; color:#7a8098; pointer-events:none; }
  .dot { display:inline-block; width:7px; height:7px; border-radius:50%;
    background:#4ade80; margin-right:5px; vertical-align:1px; }
  #micbar { position:fixed; top:calc(env(safe-area-inset-top, 0px) + 34px);
    left:50%; transform:translateX(-50%); width:120px; height:4px;
    background:#22253a; border-radius:2px; overflow:hidden; }
  #micfill { height:100%; width:0%; background:#7c8cff; transition:width .08s; }
  #keybox { position:fixed; top:0; left:0; right:0; bottom:0; background:#0a0a12;
    display:flex; flex-direction:column; gap:14px; align-items:center;
    justify-content:center; padding:30px; z-index:10; }
  #keybox input { padding:12px; width:100%; max-width:320px; border-radius:10px;
    border:1px solid #3a3f55; background:#16182a; color:#e8eaff; font-size:15px; }
  #keybox button { padding:12px 24px; border-radius:10px; border:none;
    background:#7c8cff; color:#fff; font-size:15px; }
  #keybox p { color:#7a8098; font-size:13px; text-align:center; }
  #keybox h1 { color:#e8eaff; font-size:26px; }
</style>
</head>
<body>

<video id="cam" autoplay playsinline muted></video>

<svg id="faceSvg" viewBox="0 0 400 300" preserveAspectRatio="xMidYMid meet">
  <g class="blink"><ellipse class="eye" id="eyeL" cx="150" cy="140" rx="18" ry="24" fill="#e8eaff"/></g>
  <g class="blink"><ellipse class="eye" id="eyeR" cx="250" cy="140" rx="18" ry="24" fill="#e8eaff"/></g>
  <path id="mouth" d="M170 205 Q200 218 230 205" fill="none" stroke="#e8eaff"
    stroke-width="4" stroke-linecap="round"/>
  <circle id="cheekL" cx="118" cy="178" r="10" fill="#ff7b9c" opacity="0"/>
  <circle id="cheekR" cx="282" cy="178" r="10" fill="#ff7b9c" opacity="0"/>
  <g id="ouch" opacity="0" stroke="#ff7b9c" stroke-width="3" stroke-linecap="round">
    <path d="M80 90 l14 -14 M88 74 l-3 17"/>
    <path d="M320 90 l-14 -14 M312 74 l3 17"/>
  </g>
</svg>

<div id="status">
  <span><span class="dot" id="dotCam"></span>camera</span>
  <span><span class="dot" id="dotMic"></span>mic</span>
  <span><span class="dot" id="dotAi" style="background:#fbbf24"></span><span id="aiTxt">AI off</span></span>
</div>
<div id="micbar"><div id="micfill"></div></div>
<div id="label">Boop is waking up…</div>

<div id="btns">
  <button data-m="curious">Curious</button>
  <button data-m="happy">Happy</button>
  <button data-m="surprised">Surprised</button>
  <button data-m="sleepy">Sleepy</button>
  <button data-m="shot">Pretend shot</button>
</div>

<div id="keybox">
  <h1>🤖 Boop</h1>
  <p>Ilagay ang Gemini API key para gumana ang AI vision (optional — pwede ring Start without AI).</p>
  <input id="apikey" type="password" placeholder="Gemini API key">
  <button id="startBtn">Start Boop</button>
  <button id="noAiBtn" style="background:#3a3f55">Skip AI for now</button>
</div>

<script>
const E = {
  eyeL: eyeL, eyeR: eyeR, mouth: mouth,
  cheekL: cheekL, cheekR: cheekR, ouch: ouch,
  svg: faceSvg, label: label, micfill: micfill
};
const MODES = {
  idle:      { rx:18, ry:24, mouth:'M170 205 Q200 218 230 205', txt:"Boop is idle — watching the room.", cheek:0 },
  curious:   { rx:15, ry:30, mouth:'M186 212 Q200 207 214 212', txt:"Something moved… what is that?", cheek:0 },
  happy:     { rx:18, ry:13, mouth:'M162 200 Q200 232 238 200', txt:"Boop is delighted!", cheek:0.3 },
  surprised: { rx:26, ry:30, mouth:'M188 208 Q200 199 212 208 Q200 221 188 208', txt:"Whoa! That was unexpected.", cheek:0 },
  sleepy:    { rx:18, ry:6,  mouth:'M172 210 L228 210', txt:"Zzz… Boop is sleepy.", cheek:0 },
  shot:      { rx:5,  ry:5,  mouth:'M176 214 Q200 204 224 214', txt:"Ouch! You got me… invincible again!", cheek:0.3, ouch:1 }
};
let current = 'idle', shotBusy = false;

function setMode(m, holdMs) {
  const d = MODES[m]; current = m;
  E.eyeL.setAttribute('rx', d.rx); E.eyeR.setAttribute('rx', d.rx);
  E.eyeL.setAttribute('ry', d.ry); E.eyeR.setAttribute('ry', d.ry);
  E.mouth.setAttribute('d', d.mouth);
  E.label.textContent = d.txt;
  E.cheekL.setAttribute('opacity', d.cheek || 0);
  E.cheekR.setAttribute('opacity', d.cheek || 0);
  E.ouch.setAttribute('opacity', d.ouch || 0);
  if (m === 'shot') {
    E.svg.classList.remove('shake'); void E.svg.offsetWidth; E.svg.classList.add('shake');
    navigator.vibrate && navigator.vibrate(120);
  }
  if (holdMs) setTimeout(() => { if (current === m) setMode('idle'); }, holdMs);
}

document.getElementById('btns').addEventListener('click', e => {
  const b = e.target.closest('button'); if (!b) return;
  if (b.dataset.m === 'shot') playShot(); else setMode(b.dataset.m, 2600);
});

function playShot() {
  if (shotBusy) return; shotBusy = true;
  setMode('shot', 2200);
  setTimeout(() => { shotBusy = false; }, 2400);
}

// ---------- camera ----------
async function startCamera() {
  try {
    const stream = await navigator.mediaDevices.getUserMedia({
      video: { facingMode: 'user' }, audio: true
    });
    cam.srcObject = stream;
    dotCam.style.background = '#4ade80';
    startMic(stream);
    return stream;
  } catch (e) {
    dotCam.style.background = '#ef4444';
    E.label.textContent = 'Camera denied — allow camera + mic permission.';
    throw e;
  }
}

// ---------- mic level (clap / shout -> surprised, "pew" burst -> shot) ----------
function startMic(stream) {
  const ctx = new (window.AudioContext || window.webkitAudioContext)();
  const src = ctx.createMediaStreamSource(stream);
  const an = ctx.createAnalyser(); an.fftSize = 512;
  src.connect(an);
  const buf = new Uint8Array(an.frequencyBinCount);
  let cool = 0;
  (function loop() {
    requestAnimationFrame(loop);
    an.getByteTimeDomainData(buf);
    let sum = 0;
    for (let i = 0; i < buf.length; i++) { const v = buf[i] - 128; sum += v * v; }
    const rms = Math.sqrt(sum / buf.length);
    micfill.style.width = Math.min(100, rms * 4) + '%';
    if (cool > 0) { cool--; return; }
    if (rms > 40) { cool = 45; playShot(); }
    else if (rms > 22 && current === 'idle') { cool = 30; setMode('surprised', 2000); }
  })();
  dotMic.style.background = '#4ade80';
}

// ---------- Gemini vision ----------
let geminiKey = null, aiBusy = false;
async function aiLook() {
  if (!geminiKey || aiBusy) return;
  aiBusy = true;
  try {
    const c = document.createElement('canvas');
    c.width = 480; c.height = 360;
    const x = c.getContext('2d');
    x.translate(c.width, 0); x.scale(-1, 1);
    x.drawImage(cam, 0, 0, c.width, c.height);
    const b64 = c.toDataURL('image/jpeg', 0.6).split(',')[1];
    const res = await fetch(
      'https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=' + geminiKey,
      {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          contents: [{ parts: [
            { text: `You are Boop, a playful robot. Reply ONLY in JSON: {"mood":"idle|curious|happy|surprised|sleepy","shot":true|false,"say":"one short sentence"} Set shot=true ONLY if a finger-gun hand points at the camera.` },
            { inline_data: { mime_type: 'image/jpeg', data: b64 } }
          ]}]
        })
      });
    const data = await res.json();
    const txt = data.candidates?.[0]?.content?.parts?.[0]?.text || '';
    const j = JSON.parse(txt.replace(/```json|```/g, '').trim());
    aiTxt.textContent = 'AI on';
    dotAi.style.background = '#4ade80';
    if (j.shot) playShot();
    else if (j.say) { E.label.textContent = j.say; setMode(j.mood in MODES ? j.mood : 'curious', 3000); }
  } catch (e) { /* silently retry next tick */ }
  aiBusy = false;
}

// ---------- start ----------
startBtn.onclick = async () => {
  const k = apikey.value.trim();
  if (!k) { apikey.style.borderColor = '#ef4444'; return; }
  geminiKey = k;
  keybox.style.display = 'none';
  try {
    await startCamera();
    setMode('idle');
    setInterval(aiLook, 4000);
  } catch (e) {}
};
noAiBtn.onclick = async () => {
  keybox.style.display = 'none';
  try {
    await startCamera();
    setMode('idle');
  } catch (e) {}
};
</script>
</body>
</html>
